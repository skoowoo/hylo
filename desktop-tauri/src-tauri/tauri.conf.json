{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hylo",
  "version": "0.1.0",
  "identifier": "dev.hardhacker.hylo",
  "mainBinaryName": "Hylo",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "bundleVersion": "1.1.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 130,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 220
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
