{
  "name": "hylo-desktop",
  "productName": "Hylo",
  "version": "1.1.0",
  "hyloBuild": "0",
  "private": true,
  "description": "Desktop shell for the local Hylo web app.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:editor": "cd editor && npm install && npm run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.hardhacker.hylo",
    "productName": "Hylo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "bundled/hylo.tar.gz",
          "to": "cli/hylo.tar.gz"
        }
      ]
    },
    "dmg": {
      "title": "Hylo"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "bundled/hylo.zip",
          "to": "cli/hylo.zip"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "active-win": "^8.2.1"
  }
}
